# Supabase project URL and publishable/anonymous key. These values are used by
# the SSR auth client; RLS remains the authorization boundary.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key used by the scheduled feedback engine and optional database
# integration tests. It is not required for local demo login. Never expose it
# through a NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=

# Explicitly enables infrastructure-free demo login in development only.
# Production always disables demo login even when this is true.
# Development-only demo provisioning. Never expose this value through a
# NEXT_PUBLIC_* variable and do not configure it in production.
SUPABASE_SERVICE_ROLE_KEY=

# Optional outside development. Production always disables demo login even
# when this is true.
ENABLE_DEMO_LOGIN=false

# Explicit opt-in for destructive integration-test fixture creation.
RUN_SUPABASE_INTEGRATION_TESTS=false

# Browser tests target a running local or staging application. Keep disposable
# onboarding credentials in an uncommitted .env file.
E2E_BASE_URL=http://127.0.0.1:3000
E2E_DEMO_LOGIN=false
E2E_ONBOARDING_EMAIL=
E2E_ONBOARDING_PASSWORD=
